# -----------------------------------------------------------------------------
# Frontend (required for `npm run build` — Vite inlines these into dist/)
# On cPanel, put the same VITE_* keys in /home/diplaboi/.env.diplomacylens
# (outside Git). Never commit real secrets.
# -----------------------------------------------------------------------------
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-anon-or-publishable-key
VITE_SITE_URL=https://www.example.com

# -----------------------------------------------------------------------------
# Vercel serverless only (api/*) — NOT used by cPanel static hosting
# -----------------------------------------------------------------------------
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-anon-or-publishable-key
SITE_URL=https://www.example.com

# Server-only — never use as VITE_* and never put on cPanel static hosting
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
